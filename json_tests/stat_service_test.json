{
  "info": {
    "name": "Stat Service Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9090"
    }
  ],
  "item": [
    {
      "name": "POST /hit - сохранить просмотр события 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"app\": \"ewm-main-service\",\n  \"uri\": \"/events/1\",\n  \"ip\": \"192.163.0.1\",\n  \"timestamp\": \"2026-10-20 10:00:00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/hit",
          "host": ["{{baseUrl}}"],
          "path": ["hit"]
        }
      }
    },
    {
      "name": "POST /hit - сохранить просмотр события 2",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"app\": \"ewm-main-service\",\n  \"uri\": \"/events/2\",\n  \"ip\": \"192.163.0.2\",\n  \"timestamp\": \"2026-10-20 10:05:00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/hit",
          "host": ["{{baseUrl}}"],
          "path": ["hit"]
        }
      }
    },
    {
      "name": "GET /stats - вся статистика за период",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/stats?start=2020-01-01 00:00:00&end=2030-01-01 00:00:00",
          "host": ["{{baseUrl}}"],
          "path": ["stats"],
          "query": [
            {
              "key": "start",
              "value": "2020-01-01 00:00:00"
            },
            {
              "key": "end",
              "value": "2030-01-01 00:00:00"
            }
          ]
        }
      }
    },
    {
      "name": "GET /stats - фильтр по конкретному uri",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/stats?start=2020-01-01 00:00:00&end=2030-01-01 00:00:00&uris=/events/1",
          "host": ["{{baseUrl}}"],
          "path": ["stats"],
          "query": [
            {
              "key": "start",
              "value": "2020-01-01 00:00:00"
            },
            {
              "key": "end",
              "value": "2030-01-01 00:00:00"
            },
            {
              "key": "uris",
              "value": "/events/1"
            }
          ]
        }
      }
    },
    {
      "name": "GET /stats - только уникальные IP (unique=true)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/stats?start=2020-01-01 00:00:00&end=2030-01-01 00:00:00&unique=true",
          "host": ["{{baseUrl}}"],
          "path": ["stats"],
          "query": [
            {
              "key": "start",
              "value": "2020-01-01 00:00:00"
            },
            {
              "key": "end",
              "value": "2030-01-01 00:00:00"
            },
            {
              "key": "unique",
              "value": "true"
            }
          ]
        }
      }
    }
  ]
}
