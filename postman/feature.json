        },
        {
          "name": "[201] Создать событие",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/{{otherId}}/events",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"annotation\":\"Тестовое событие для проверки комментариев\",\"category\":{{categoryId}},\"description\":\"Подробное описание события для проверки комментариев пользователей\",\"eventDate\":\"{{eventDate}}\",\"location\":{\"lat\":55.75,\"lon\":37.61},\"paid\":false,\"participantLimit\":0,\"requestModeration\":false,\"title\":\"Событие для комментариев\"}"
            }
          }
        },
        {
          "name": "[200] Опубликовать событие",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/events/{{eventId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"stateAction\":\"PUBLISH_EVENT\"}"
            }
          }
        },
        {
          "name": "[201] Создать неопубликованное событие",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/{{otherId}}/events",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"annotation\":\"Событие пока ожидает проверки администратором\",\"category\":{{categoryId}},\"description\":\"Подробное описание неопубликованного события для негативного сценария\",\"eventDate\":\"{{eventDate}}\",\"location\":{\"lat\":55.75,\"lon\":37.61},\"paid\":false,\"participantLimit\":0,\"title\":\"Неопубликованное событие\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Комментарии",
